@model Moo_Arvelous_Coders.Models.HerdComment

<div class="comment-panel">
    <h3 class="comment-title">COMMENT ON HERD</h3>
    <p class="comment-subtitle">Use this as a digital notebook to keep important notes on your herd.</p>

    <form asp-controller="HerdComments" asp-action="Create" method="post">
        <div class="form-group">
            <label>Select a herd to comment on:</label>
            <select asp-for="HerdId" class="form-control comment-dropdown">
                <option value="">( Select correct herd )</option>
                @foreach (var herd in ViewBag.Herds as List<Moo_Arvelous_Coders.Models.Herd>)
                {
                    <option value="@herd.HerdId">@herd.HerdName</option>
                }
            </select>
            <span asp-validation-for="HerdId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Create your herd comment:</label>
            <textarea asp-for="CommentDescription" class="form-control comment-textarea"
                      placeholder="Add extra comments regarding any camp movements, treatments, feed, etc."></textarea>
            <span asp-validation-for="CommentDescription" class="text-danger"></span>
        </div>

        <div class="herd-form-actions">
            <button type="submit" class="comment-submit-btn">RECORD COMMENT</button>
            <button type="reset" class="comment-clear-btn">CLEAR COMMENT</button>
        </div>
    </form>
</div>

