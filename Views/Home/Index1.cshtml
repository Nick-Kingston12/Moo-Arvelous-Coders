@model dynamic
@{
    ViewData["Title"] = "Welcome to HerdWise";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="landing-wrapper">

    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
 
        <div class="top-heading">
            <h1 class="welcome-title">Welcome to Herdwise!</h1>
            <div class="top-line"></div>
        </div>

        <div class="right-text">
            <div class="heading-group">
                <strong>Your<br> Herd,<br /></strong>
                <span class="managed">Managed.</span>
            </div>
            <div class="button-group">
                <div class="button-item">
                    <a href="/Farmers/Create" class="home-button">REGISTER FARMER</a>
                    <p class="button-description">Create your farmer account to manage herds.</p>
                </div>

                <div class="button-item">
                    <a href="/Buyer/Create" class="home-button">REGISTER BUYER</a>
                    <p class="button-description">Sign up to view and buy cattle.</p>
                </div>

                <div class="button-item">
                    <a href="/Account/Login" class="home-button">LOGIN</a>
                    <p class="button-description">Access your dashboard and manage your farm.</p>
                </div>
            </div>



        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>
