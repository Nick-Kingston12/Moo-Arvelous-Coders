@model dynamic
@{
    ViewData["Title"] = "Welcome to HerdWise";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="landing-page">
    <img src="~/images/landing-page.png" alt="landing-background" class="background-image" />

    <div class="landing-left">
    </div>

    <div class="landing-right">
        <h1 class="welcome-title">Welcome to Herdwise!</h1>
        <hr class="top-line" />

        <div class="right-text">
            <p class="your-herd">
                Your<br>
                <span class="managed">Herd,<br /> Managed.</span>
            </p>

            <div class="button-group">
                <div class="button-wrapper">
                    <a href="/Account/RegisterFarmer" class="home-button">REGISTER FARMER</a>
                    <p class="button-subtext">Create a farming profile.</p>
                </div>
                <div class="button-wrapper">
                    <a href="/Account/RegisterBuyer" class="home-button">REGISTER BUYER</a>
                    <p class="button-subtext">For auction access.</p>
                </div>
                <div class="button-wrapper">
                    <a href="/Account/Login" class="home-button">LOGIN</a>
                    <p class="button-subtext">Already have a profile?</p>
                </div>
            </div>
        </div>

        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>
