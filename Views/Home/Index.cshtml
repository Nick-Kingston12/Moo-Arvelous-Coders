@{
    ViewData["Title"] = "Welcome to HerdWise";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <div >
            <h2 class="welcome-title">Welcome to Herdwise!</h2>
        </div>

        <div class="search-bar">
            <input type="text" placeholder="Search ..." />
            <button><i class="fas fa-search"></i></button>
        </div>

        <div class="home-buttons">
            <a class="btn" href="/Farmers/Index">PERSONAL ACCOUNT</a>
            <p class="button-sub">View all personal account details. Edit and update all personal account details.</p>

            <a class="btn" href="/Farms/Index">FARMS</a>
            <p class="button-sub">Create and add a new farm(s). Edit, update and delete farm details.</p>

            <a class="btn" href="/Herds/Index">HERDS</a>
            <p class ="button-sub">Create and add a new herd(s). Edit, update and delete herd details. Create, add and edit cattle in herds.</p>

            <a class="btn logout" href="/Account/Logout">LOGOUT</a>
            <p class="button-sub">Ready to logout and hit the hay?</p>
        </div>


        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>

    </div>

    <button class="menu-button">MENU</button>
</div>
