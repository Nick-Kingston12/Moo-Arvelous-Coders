@model Moo_Arvelous_Coders.Models.Buyer

@{
    ViewData["Title"] = "Edit Buyer";
}

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">Edit Buyer</h2>
        <p>Update your personal information below.</p>

        <div class="account-box">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BuyerId" />

                <dl class="row">
                    <dt class="col-sm-4">First Name:</dt>
                    <dd class="col-sm-8"><input asp-for="BfirstName" class="form-control" /></dd>

                    <dt class="col-sm-4">Last Name:</dt>
                    <dd class="col-sm-8"><input asp-for="BlastName" class="form-control" /></dd>

                    <dt class="col-sm-4">ID Number:</dt>
                    <dd class="col-sm-8"><input asp-for="Bidnumber" class="form-control" /></dd>

                    <dt class="col-sm-4">Phone Number:</dt>
                    <dd class="col-sm-8"><input asp-for="BphoneNumber" class="form-control" /></dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8"><input asp-for="Bemail" class="form-control" /></dd>

                    <dt class="col-sm-4">Organization:</dt>
                    <dd class="col-sm-8"><input asp-for="OrganizationName" class="form-control" /></dd>
                </dl>

                <div class="button-row">
                    <button type="submit" class="home-button">SAVE CHANGES</button>
                    <a asp-action="Details" asp-route-id="@Model.BuyerId" class="home-button btn-secondary">Cancel</a>
                </div>
            </form>
        </div>

        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>

@section Scripts {
@{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
