@model Moo_Arvelous_Coders.Models.Buyer

@{
    ViewData["Title"] = "Edit Buyer";
}

<div class="personal-account-container">
    <div class="herd-header" style="text-align:center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">EDIT BUYER</h1>
        <p class="subtitle">Update your personal buyer information below.</p>
    </div>

    <div class="account-container">
        <div class="account-box">
            <form asp-action="Edit" asp-controller="Buyer" asp-route-id="@Model.BuyerId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BuyerId" />

                <h3 class="form-heading">Edit Information</h3>

                <label asp-for="BfirstName">First Name:</label>
                <input asp-for="BfirstName" class="form-control" />
                <span asp-validation-for="BfirstName" class="text-danger"></span>

                <label asp-for="BlastName">Last Name:</label>
                <input asp-for="BlastName" class="form-control" />
                <span asp-validation-for="BlastName" class="text-danger"></span>

                <label asp-for="Bidnumber">ID Number:</label>
                <input asp-for="Bidnumber" class="form-control" />
                <span asp-validation-for="Bidnumber" class="text-danger"></span>

                <label asp-for="BphoneNumber">Phone Number:</label>
                <input asp-for="BphoneNumber" class="form-control" />
                <span asp-validation-for="BphoneNumber" class="text-danger"></span>

                <label asp-for="Bemail">Email:</label>
                <input asp-for="Bemail" class="form-control" />
                <span asp-validation-for="Bemail" class="text-danger"></span>

                <label asp-for="OrganizationName">Organization:</label>
                <input asp-for="OrganizationName" class="form-control" />
                <span asp-validation-for="OrganizationName" class="text-danger"></span>

                <label>New Password</label>
                <input asp-for="BPassword" type="password" class="form-control" />
                <span asp-validation-for="BPassword" class="text-danger"></span>

                <label>Confirm New Password</label>
                <input asp-for="BConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="BConfirmPassword" class="text-danger"></span>


                <div class="button-row">
                    <button type="submit" class="submit-btn">SAVE CHANGES</button>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
