@model Moo_Arvelous_Coders.Models.Buyer

@{
    ViewData["Title"] = "Buyer Details";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="personal-account-container">
    <div class="herd-header" style="text-align:center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">BUYER DETAILS</h1>
        <p class="subtitle">View detailed information about this buyer profile.</p>
    </div>

    <div class="account-container">
        <div class="account-box">
            <h3 class="form-heading">Personal Information</h3>
            <dl>
                <dt>First Name:</dt>
                <dd>@Model.BfirstName</dd>

                <dt>Last Name:</dt>
                <dd>@Model.BlastName</dd>

                <dt>ID Number:</dt>
                <dd>@Model.Bidnumber</dd>

                <dt>Phone Number:</dt>
                <dd>@Model.BphoneNumber</dd>

                <dt>Email Address:</dt>
                <dd>@Model.Bemail</dd>

                <dt>Organization:</dt>
                <dd>@Model.OrganizationName</dd>
            </dl>

            <div class="button-row">
                <a asp-action="Edit" asp-route-id="@Model.BuyerId" class="submit-btn">EDIT</a>
                <a asp-action="Index" class="clear-btn">BACK TO LIST</a>
            </div>
        </div>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>
