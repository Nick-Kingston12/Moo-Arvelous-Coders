@model Moo_Arvelous_Coders.Models.Buyer

@{
    ViewData["Title"] = "Buyer Details";
}

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">Buyer Details</h2>
        <p>View detailed information about the buyer.</p>

        <div class="account-box">
            <h3 class="form-heading">Personal Information</h3>
            <dl class="row">
                <dt class="col-sm-4">First Name:</dt>
                <dd class="col-sm-8">@Model.BfirstName</dd>

                <dt class="col-sm-4">Last Name:</dt>
                <dd class="col-sm-8">@Model.BlastName</dd>

                <dt class="col-sm-4">ID Number:</dt>
                <dd class="col-sm-8">@Model.Bidnumber</dd>

                <dt class="col-sm-4">Phone Number:</dt>
                <dd class="col-sm-8">@Model.BphoneNumber</dd>

                <dt class="col-sm-4">Email:</dt>
                <dd class="col-sm-8">@Model.Bemail</dd>

                <dt class="col-sm-4">Organization:</dt>
                <dd class="col-sm-8">@Model.OrganizationName</dd>
            </dl>

            <div class="button-row">
                <a asp-action="Edit" asp-route-id="@Model.BuyerId" class="home-button">Edit</a>
                <a asp-action="Index" class="home-button btn-secondary">Back to List</a>
            </div>
        </div>

        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>
