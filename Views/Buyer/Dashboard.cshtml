@{
    ViewData["Title"] = "Welcome to HerdWise Buyer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville&family=Poppins:wght@300;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

<div class="landing-wrapper">

    <!-- LEFT BROWN PANEL -->
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <!-- RIGHT CONTENT -->
    <div class="right-content">
        <div class="top-heading">
            <h1 class="welcome-title">Welcome to HerdWise Buyer!</h1>
            <div class="top-line"></div>
        </div>

        <div class="right-text">
            <div class="heading-group">
                <strong>Your<br> Buyer<br /></strong>
                <span class="managed">Experience.</span>
            </div>
            <!-- SEARCH BAR -->
            <!-- SEARCH BAR -->
            <div class="search-container">
                <div class="search-bar">
                    <input type="text" id="searchInputBuyer" placeholder="Search cattle, farms, or farmers..." autocomplete="off" />
                    <button type="button" class="search-btn">
                        <i class="fas fa-search"></i>
                    </button>
                </div>

                <ul id="searchResultsBuyer" class="search-results"></ul>
            </div>

            <script>
                document.getElementById("searchInputBuyer").addEventListener("input", async function () {
                    const query = this.value.trim();
                    const resultsContainer = document.getElementById("searchResultsBuyer");
                    resultsContainer.innerHTML = "";

                    if (query.length < 2) return;

                    const response = await fetch(`/Search/BuyerSearch?query=${encodeURIComponent(query)}`);
                    const results = await response.json();

                    if (!results.results || results.results.length === 0) {
                        resultsContainer.innerHTML = "<li class='no-results'>No results found</li>";
                        return;
                    }

                    results.results.forEach(item => {
                        const li = document.createElement("li");
                        li.innerHTML = `<a href="${item.url}">${item.title} <span class="result-type">(${item.type})</span></a>`;
                        resultsContainer.appendChild(li);
                    });
                });
            </script>




            <!-- BUTTONS STACKED VERTICALLY WITH TEXT NEXT TO BUTTON -->
            <div class="button-group-left">
                <div class="button-item-horizontal">
                    <a href="/Buyer/Index" class="home-button">PERSONAL ACCOUNT</a>
                    <p class="button-description">View and edit your buyer account details.</p>
                </div>

                <div class="button-item-horizontal">
                    <a href="/Cattle/ForSale" class="home-button">FOR SALE</a>
                    <p class="button-description">View all cattle listed for sale.</p>
                </div>

                <div class="button-item-horizontal">
                    <a href="/Farmers/Index" class="home-button">FARMERS</a>
                    <p class="button-description">See all registered farmers and contact details.</p>
                </div>

                <div class="button-item-horizontal">
                    <a href="/Account/Logout" class="home-button logout">LOGOUT</a>
                    <p class="button-description">Ready to logout and hit the hay?</p>
                </div>
            </div>
        </div>

        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>
