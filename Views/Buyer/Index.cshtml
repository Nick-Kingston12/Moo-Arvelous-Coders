@model IEnumerable<Moo_Arvelous_Coders.Models.Buyer>

@{
    ViewData["Title"] = "Buyers";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="page-container">
    <!-- HEADER -->
    <div class="farm-header" style="text-align: center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">BUYERS</h1>
        <p class="subtitle">Manage registered buyers. View details, or remove from the system.</p>
    </div>

    <!-- CREATE BUTTON -->
    <div class="form-container" style="justify-content: center; margin-top: 1rem;">
        <a asp-action="Create" class="btn create-btn">CREATE NEW BUYER</a>
    </div>

    <!-- TABLE SECTION -->
    <div class="farmers-table-container" style="margin-top: 2rem;">
        <div class="farmers-table-header">Buyers List</div>

        <table class="farmers-table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>ID Number</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Organization</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="buyerList">
                @foreach (var buyer in Model)
                {
                    <tr class="buyer-item">
                        <td>@buyer.BfirstName</td>
                        <td>@buyer.BlastName</td>
                        <td>@buyer.Bidnumber</td>
                        <td>@buyer.BphoneNumber</td>
                        <td>@buyer.Bemail</td>
                        <td>@buyer.OrganizationName</td>
                        <td>
                            <div style="display:flex; gap:8px; justify-content:center;">
                                <a asp-action="Details" asp-route-id="@buyer.BuyerId" class="btn save-btn">DETAILS</a>
                                <a asp-action="Delete" asp-route-id="@buyer.BuyerId" class="btn delete-btn">DELETE</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Arrows for pagination -->
        <div class="arrow-nav" style="margin-top:10px;">
            <span class="arrow left-arrow" id="buyerPrevArrow">←</span>
            <span class="arrow right-arrow" id="buyerNextArrow">→</span>
        </div>
    </div>

    <!-- FOOTER -->
    <div>
        <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        setupPagination("#buyerList tr", "#buyerPrevArrow", "#buyerNextArrow", 5);
    </script>
}
