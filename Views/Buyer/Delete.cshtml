@model Moo_Arvelous_Coders.Models.Buyer

@{
    ViewData["Title"] = "Delete Buyer";
}

<div class="personal-account-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">DELETE ACCOUNT</h1>
        <p class="subheading">Confirm if you want to remove this buyer</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="account-container">
        <div class="account-box">
            <h3 class="form-heading">Buyer Information</h3>

            <dl class="row">
                <dt class="col-sm-3">First Name:</dt>
                <dd class="col-sm-9">@Model.BfirstName</dd>

                <dt class="col-sm-3">Last Name:</dt>
                <dd class="col-sm-9">@Model.BlastName</dd>

                <dt class="col-sm-3">ID Number:</dt>
                <dd class="col-sm-9">@Model.Bidnumber</dd>

                <dt class="col-sm-3">Phone Number:</dt>
                <dd class="col-sm-9">@Model.BphoneNumber</dd>

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.Bemail</dd>

                <dt class="col-sm-3">Organization:</dt>
                <dd class="col-sm-9">@Model.OrganizationName</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.BuyerId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BuyerId" />
                <div class="button-row">
                    <button type="submit" class="delete-btn">DELETE ACCOUNT</button>
                    <a asp-action="Index" class="cancel-btn">CANCEL</a>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>
