@model Moo_Arvelous_Coders.Models.SearchViewModel

@{
    ViewData["Title"] = "Search";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="search-container">
    <h2>SEARCH BY ID</h2>
    <p>Enter a Farm ID, Herd ID, or Cattle ID to navigate directly to its page.</p>

    <form method="post">
        <input asp-for="SearchId" class="form-control" placeholder="Enter ID..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    @if (!string.IsNullOrEmpty(Model?.Message))
    {
        <div class="text-danger mt-2">
            @Model.Message
        </div>
    }
</div>
