@model Moo_Arvelous_Coders.Models.Farm

@{
    ViewData["Title"] = "Delete Farm";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-create-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" class="logo-top" />
        <h1>DELETE FARM</h1>
        <p class="subtitle">Are you sure you want to delete this farm?</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="farm-content">
        <img src="~/images/Farm.png" class="farm-image" />


        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <input type="hidden" asp-for="FarmId" />
            <div class="form-box">
                <p><strong>@Model.FarmName</strong></p>
                <p>@Model.Location</p>
                <p>Size: @Model.FarmSize</p>
                <p>Price: R @Model.PriceBought</p>
            </div>

            <button type="submit" class="delete-farm-button">YES, DELETE</button>
        </form>

        <!-- This is placed OUTSIDE the form now -->
        <div class="go-back-container">
            <a href="/Farms/Index" class="menu-button">NO, GO BACK</a>
        </div>
        
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
</div>

