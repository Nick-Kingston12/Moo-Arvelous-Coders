@model Moo_Arvelous_Coders.Models.Farm

@{
    ViewData["Title"] = "Create Farm";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-create-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class ="form-title">CREATE FARM</h1>
        <p class="subheading">Personal farmer profile has been created. Create your farm.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="form-herd-container">

        <div class="image-container-herd">
            <img src="~/images/sign.png" alt="Cartoon Herd" />
        </div>

    <div class="farm-content">

        <form asp-action="Create" method="post" class="farm-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @if (Model?.FarmId != null)
            {
                <div class="form-group">
                    <label>Farm ID (generated):</label>
                    <input class="form-control" value="@Model.FarmId" readonly />
                </div>
            }


            <label asp-for="FarmName"></label>
            <input asp-for="FarmName" class="form-control" />
            <span asp-validation-for="FarmName" class="text-danger"></span>

            <label asp-for="Location"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>

            <label asp-for="FarmSize"></label>
            <input asp-for="FarmSize" class="form-control" />
            <span asp-validation-for="FarmSize" class="text-danger"></span>

            <label asp-for="PriceBought"></label>
            <input asp-for="PriceBought" class="form-control" />
            <span asp-validation-for="PriceBought" class="text-danger"></span>

            <label asp-for="Manager"></label>
            <input asp-for="Manager" class="form-control" />
            <span asp-validation-for="Manager" class="text-danger"></span>

            @if (Model?.FarmId != null)
            {
                <p><strong>Generated Farm ID:</strong> @Model.FarmId</p>
            }


                <div class="herd-form-actions">
                    <button type="reset" class="home-button">CLEAR FORM</button>
                    <button type="submit" class="home-button">ADD FARM</button>
                </div>
        </form>

    </div>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
</div>

