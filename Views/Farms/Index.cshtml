@model IEnumerable<Moo_Arvelous_Coders.Models.Farm>

@{
    ViewData["Title"] = "Farms";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-list-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">FARMS</h1>
        <p class="subtitle">Welcome to your farm. Visit an existing farm or create a new one.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="form-container">
        <a class="btn create-btn" href="/Farms/Create">CREATE NEW FARM</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="form-container">
        <div class="farm-list-box">
            <div class="box-header">Visit Your Created Farm</div>
            <p class="instruction">Click on one of the farm links below to select and access your farm.</p>

            <ol class="farm-list">
                @foreach (var farm in Model)
                {
                    <li>
                        <a href="/Farms/Details/@farm.FarmId">@farm.FarmName</a>
                        <span class="button-group">
                            <a href="/Farms/Edit/@farm.FarmId" class="btn edit-btn">Edit</a>
                            <a href="/Farms/Delete/@farm.FarmId" class="btn delete-btn">Delete</a>
                        </span>
                    </li>
                }
            </ol>

            <div class="arrow-nav">
                <span class="arrow left-arrow">←</span>
                <span class="arrow right-arrow">→</span>
            </div>
        </div>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
</div>
