@model IEnumerable<Moo_Arvelous_Coders.Models.Farm>

@{
    ViewData["Title"] = "Farms";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="page-container">
    <!-- HEADER -->
    <div class="farm-header" style="text-align: center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">FARMS</h1>
        <p class="subtitle">Welcome to your farm. Visit an existing farm or create a new one.</p>
    </div>

    <!-- CREATE BUTTON -->
    <div class="form-container" style="justify-content: center; margin-top: 1rem;">
        <a class="btn create-btn" href="/Farms/Create">CREATE NEW FARM</a>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message" style="text-align:center; margin-top:1rem;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- FARM LIST TABLE STYLE -->
    <div class="farmers-table-container" style="margin-top: 2rem;">
        <div class="farmers-table-header">Farms List</div>

        <table class="farmers-table">
            <thead>
                <tr>
                    <th>Farm Name</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="farmList">
                @foreach (var farm in Model)
                {
                    <tr class="farm-item">
                        <td>@farm.FarmName</td>
                        <td>
                            <div style="display:flex; gap:8px; justify-content:center;">
                                <a href="/Farms/Details/@farm.FarmId" class="btn save-btn">DETAILS</a>
                                <a href="/Farms/Edit/@farm.FarmId" class="btn edit-btn">EDIT</a>
                                <a href="/Farms/Delete/@farm.FarmId" class="btn delete-btn">DELETE</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- ARROWS FOR PAGINATION -->
        <div class="arrow-nav" style="margin-top:10px;">
            <span class="arrow left-arrow" id="prevArrow">←</span>
            <span class="arrow right-arrow" id="nextArrow">→</span>
        </div>
    </div>

    <!-- FOOTER -->
    <div>
        <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        setupPagination("#farmList tr", "#prevArrow", "#nextArrow", 5);
    </script>
}
