@model Moo_Arvelous_Coders.Models.Farm

@{
    ViewData["Title"] = "Farm Details";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-details-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">@Model.FarmName</h1>
        <p class="subtitle">Here’s your farm’s profile and information.</p>
        <a class="menu-button" href="/Farms/Index">BACK TO FARMS</a>
    </div>

    <div class="form-container">
    <div class="farm-details-box">
        <div class="box-header">Farm Information</div>
        <p><strong>Farm ID:</strong> @Model.FarmId</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Size:</strong> @Model.FarmSize acres</p>
        <p><strong>Price Bought:</strong> @Model.PriceBought</p>
        <p><strong>Farm Manager:</strong> @Model.Manager</p>
    </div>

    <div class="farm-details-actions">
        <a href="/Farms/Edit/@Model.FarmId" class="btn edit-btn">Edit</a>
        <a href="/Farms/Delete/@Model.FarmId" class="btn delete-btn">Delete</a>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
</div>
