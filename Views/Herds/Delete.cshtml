@model Moo_Arvelous_Coders.Models.Herd

@{
    ViewData["Title"] = "Delete Herd";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-create-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">DELETE HERD</h1>
        <p class="subtitle">Are you sure you want to delete this herd?</p>
        
    </div>

    <div class="farm-content">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="HerdId" />
            <div class="form-box">
                <p><strong>Herd ID:</strong> @Model.HerdId</p>
                <p><strong>Name:</strong> @Model.HerdName</p>
                <p><strong>Size:</strong> @Model.Herdsize</p>
            </div>

            <div class="form-actions">
                <button type="submit" class="delete-btn">YES, DELETE</button>
                <a href="/Herds/Index" class="cancel-btn">NO, GO BACK</a>
            </div>
        </form>
    </div>


    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
