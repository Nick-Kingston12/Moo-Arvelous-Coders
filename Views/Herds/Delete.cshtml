@model Moo_Arvelous_Coders.Models.Herd

@{
    ViewData["Title"] = "Delete Herd";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="herd-create-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">DELETE HERD</h1>
        <p class="subheading">Are you sure you want to permanently delete this herd?</p>
    </div>

    <div class="form-herd-container">
        <div class="image-container-herd">
            <img src="~/images/herd.png" alt="Cartoon Herd" />
        </div>

        <div class="herd-content">
            <form asp-action="Delete" method="post" class="herd-form">
                <input type="hidden" asp-for="HerdId" />

                <div class="delete-summary">
                    <p><strong>Herd ID:</strong> @Model.HerdId</p>
                    <p><strong>Name:</strong> @Model.HerdName</p>
                    <p><strong>Size:</strong> @Model.Herdsize</p>
                </div>

                <div class="herd-form-actions">
                    <button type="submit" class="home-button" style="background-color: #d9534f;">YES, DELETE</button>
                    <a href="/Herds/Index" class="home-button" style="background-color: #ccc; color: #333;">CANCEL</a>
                </div>
            </form>
        </div>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
