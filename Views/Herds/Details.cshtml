@model Moo_Arvelous_Coders.Models.Herd

@{
    ViewData["Title"] = "Herd Details";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-create-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">HERD DETAILS</h1>
        <p class="subtitle">Review herd information.</p>
        <a class="menu-button" href="/Herds">BACK TO HERDS</a>
    </div>

    <div class="farm-content">
        <img src="~/images/cows-group.png" class="herd-image" />

        <div class="form-box">
            <div class="form-header">Herd Info</div>

            <p><strong>Herd ID:</strong> @Model.HerdId</p>
            <p><strong>Herd Name:</strong> @Model.HerdName</p>
            <p><strong>Herd Size:</strong> @Model.Herdsize</p>
        </div>
    </div>

    <div class="form-box">
        <div class="form-header">Herd Comments</div>
        @if (Model.HerdComments != null && Model.HerdComments.Any())
        {
            <ul>
                @foreach (var comment in Model.HerdComments)
                {
                    <li>@comment.CommentDescription</li>
                }
            </ul>
        }
        else
        {
            <p>No comments yet.</p>
        }
    </div>


    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
