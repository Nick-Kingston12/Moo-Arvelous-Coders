@model Moo_Arvelous_Coders.Models.Herd

@{
    ViewData["Title"] = "Herd Details";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-create-container">
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">HERD DETAILS</h1>
        <p class="subtitle">Review herd information.</p>
        
    </div>

    <!-- Herd Info -->
    <div class="form-box">
        <div class="form-header">Herd Info</div>
        <p><strong>Herd ID:</strong> @Model.HerdId</p>
        <p><strong>Herd Name:</strong> @Model.HerdName</p>        
        <p><strong>Herd Size:</strong> @Model.Herdsize</p>
    </div>

    <!-- Cattle List -->
    <div class="form-box">
        <div class="form-header">Cattle in this Herd</div>
        @if (Model.Cattles != null && Model.Cattles.Any())
        {
            <table class="records-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Breed</th>
                        <th>Gender</th>
                        <th>Weight</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cattle in Model.Cattles)
                    {
                        <tr>
                            <td>@cattle.CattleId</td>
                            <td>@cattle.Breed</td>
                            <td>@cattle.Gender</td>
                            <td>@cattle.Weight</td>
                            <td>@cattle.Status</td>
                            <td>
                                <a asp-controller="Cattle" asp-action="Details" asp-route-id="@cattle.CattleId" class="btn">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No cattle in this herd yet.</p>
        }
    </div>

    <!-- Herd Comments -->
    <div class="form-box">
        <div class="form-header">Herd Comments</div>
        @if (Model.HerdComments != null && Model.HerdComments.Any())
        {
            <ul>
                @foreach (var comment in Model.HerdComments)
                {
                    <li style="display:flex; justify-content:space-between; align-items:center;">
                        <span>@comment.CommentDescription</span>
                        <form asp-controller="HerdComments" asp-action="Delete" method="post" style="margin:0;">
                            <input type="hidden" name="id" value="@comment.CommentId" />
                            <button type="submit" class="btn delete-btn" style="padding:4px 10px;">Delete</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No comments yet.</p>
        }
    </div>


    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
