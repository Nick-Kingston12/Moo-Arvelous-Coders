@model Moo_Arvelous_Coders.Models.Herd

@{
    ViewData["Title"] = "Create Herd";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="herd-create-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">CREATE HERD</h1>
        <p class="subheading">Farm profile has been created. Create and add your new herd.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="form-herd-container">

    <div class="image-container-herd">
        <img src="~/images/herd.png" alt="Cartoon Herd" />
    </div>

    <div class="herd-content">

        <form asp-action="Create" method="post" class="herd-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @if (Model?.HerdId != null)
            {
                <div class="form-group">
                    <label>Herd ID (generated):</label>
                    <input class="form-control" value="@Model.HerdId" readonly />
                </div>
            }

            <label asp-for="HerdName"></label>
            <input asp-for="HerdName" class="form-control" placeholder="e.g. Herd Thunder" />
            <span asp-validation-for="HerdName" class="text-danger"></span>

            <label asp-for="Herdsize"></label>
            <input asp-for="Herdsize" class="form-control" type="number" />
            <span asp-validation-for="Herdsize" class="text-danger"></span>

            <div class="animal-buttons">
                    <button type="button" class="animal-btn" onclick="location.href='@Url.Action("Create", "Cattle")'">Add Cattle</button>

            </div>

            <div class="herd-form-actions">
                <button type="reset" class="home-button">CLEAR FORM</button>
                <button type="submit" class="home-button">ADD HERD</button>

            </div>
            

        </form>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger" style="margin-top: 1rem;">
                ❗ Please correct the highlighted errors before submitting the form.
            </div>
        }

    </div>
    </div>
    <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
</div>

