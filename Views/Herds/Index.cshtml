@model IEnumerable<Moo_Arvelous_Coders.Models.Herd>

@{
    ViewData["Title"] = "Manage Herds";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="farm-list-container">
    <!-- Header -->
    <div class="farm-header" style="text-align: center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">HERDS</h1>
        <p class="subtitle">Welcome to your farm. Visit an existing herd or create a new one.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <!-- Centered Create Herd Button -->
    <div class="form-container" style="justify-content: center; margin-top: 1rem;">
        <a class="btn create-btn" href="/Herds/Create">CREATE NEW HERD</a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message" style="text-align:center; margin-top:10px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Two-Panel Section -->
    <div class="dashboard-container">
        <!-- LEFT: Herd List -->
        <div class="dashboard-box herd-box">
            <h3>Your Herds</h3>
            <p class="instruction">Click on a herd below to manage or update details.</p>

            <ol id="herdList" class="herd-list">
                @foreach (var herd in Model)
                {
                    <li class="herd-item">
                        <span class="herd-name">@herd.HerdName</span>
                        <div class="button-group" style="margin-top:8px;">
                            <a href="/Herds/Details/@herd.HerdId" class="btn details-btn">VIEW DETAILS</a>
                            <a href="/Herds/Edit/@herd.HerdId" class="btn edit-btn">EDIT</a>
                            <a href="/Herds/Delete/@herd.HerdId" class="btn delete-btn">DELETE</a>
                        </div>
                    </li>
                }
            </ol>


            <div class="arrow-nav">
                <span class="arrow left-arrow" id="herdPrevArrow">←</span>
                <span class="arrow right-arrow" id="herdNextArrow">→</span>
            </div>
        </div>

        <!-- RIGHT: Comment Panel -->
        <div class="comment-box">
            <h3>COMMENT ON HERD</h3>
            <p>Use this as a digital notebook to keep important notes on your herd.</p>
            @await Html.PartialAsync("~/Views/HerdComments/CommentPanel.cshtml",
            new Moo_Arvelous_Coders.Models.HerdComment())
        </div>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
@section Scripts {
        <script src="~/js/pagination.js"></script>
        <script>
            setupPagination("#herdList li", "#herdPrevArrow", "#herdNextArrow", 5);
        </script>
}
