@model IEnumerable<Moo_Arvelous_Coders.Models.Herd>

@{
    ViewData["Title"] = "Manage Herds";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="farm-list-container">
    <!-- Header -->
    <div class="farm-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">HERDS</h1>
        <p class="subtitle">Manage your herds. Edit, delete, view, or create new ones.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <!-- Create Herd Button -->
    <div class="farm-center-button">
        <a class="btn create-btn" href="/Herds/Create">CREATE NEW HERD</a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Herd List + Comment Panel -->
    <div style="display: flex; gap: 40px;">
        <!-- LEFT: Herd List -->
        <div style="flex: 1;">
            <div class="farm-list-box">
                <div class="box-header">Your Herds</div>
                <ol class="farm-list">
                    @foreach (var herd in Model)
                    {
                        <li>
                            <strong>@herd.HerdName</strong> (Size: @herd.Herdsize)
                            <a href="/Herds/Details/@herd.HerdId" class="btn details-btn">Details</a>
                            <a href="/Herds/Edit/@herd.HerdId" class="btn edit-btn">Edit</a>
                            <a href="/Herds/Delete/@herd.HerdId" class="btn delete-btn">Delete</a>
                        </li>
                    }
                </ol>
            </div>
        </div>

        <!-- RIGHT: Comment Panel -->
        <div style="flex: 1;">
            @* Simply render the partial; ViewBag.Herds is already available *@
            @await Html.PartialAsync("~/Views/HerdComments/CommentPanel.cshtml",
            new Moo_Arvelous_Coders.Models.HerdComment())
        </div>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
