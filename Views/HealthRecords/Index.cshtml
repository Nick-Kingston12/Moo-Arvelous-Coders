@model Moo_Arvelous_Coders.Models.HealthRecordViewModel
@{
    ViewData["Title"] = "Health Records";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="health-records-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="Logo" class="logo-top" />
        <h1 class="welcome-title" style="max-width: 400px; margin: 0 auto;">HEALTH RECORDS</h1>
    </div>

    <div class="records-section" style="max-width: 600px; margin: 0 auto;">
        <h3 class="form-headingC" style="max-width: 400px;">ADD / UPDATE HEALTH RECORD</h3>

        <form asp-action="SaveHealthRecord" method="post">
            <input type="hidden" asp-for="CattleId" value="@Model.CattleId" />

            <label>Date of Entry:</label>
            <input type="date" asp-for="CattleHealthRecord.RecordDate"
                   value="@(Model.CattleHealthRecord.RecordDate == default ? DateTime.Today.ToString("yyyy-MM-dd") : Model.CattleHealthRecord.RecordDate.ToString("yyyy-MM-dd"))"
                   class="form-control" />

            <label>Treatment Type:</label>
            <select asp-for="CattleHealthRecord.TreatmentType" class="form-control">
                <option value="">-- Select a treatment --</option>
                <option>Flu Vaccination</option>
                <option>Worm Medicine / Deworming</option>
                <option>Vitamin Injection</option>
                <option>Antibiotic Treatment</option>
                <option>Foot Rot Treatment</option>
                <option>Mastitis Treatment</option>
                <option>Brucellosis Vaccine</option>
                <option>Rabies Vaccination</option>
                <option>Pinkeye Treatment</option>
            </select>

            <label>Details:</label>
            <textarea asp-for="CattleHealthRecord.Details" class="form-control"></textarea>

            <button type="submit" class="record-btn" style="width: 180px; margin-top: 10px;">SAVE HEALTH ENTRY</button>
        </form>

        <hr />

        <h3 class="form-headingC" style="max-width: 400px;">EXISTING RECORDS</h3>
        <table class="records-table" style="max-width: 600px; margin: 0 auto;">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Treatment</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.ExistingRecords)
                {
                    <tr>
                        <td>@record.RecordDate.ToString("yyyy-MM-dd")</td>
                        <td>@record.TreatmentType</td>
                        <td>@record.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<footer class="footer-text">
    <p>Healthy cows, happy farmers — powered by HerdWise.</p>
</footer>
