@model Moo_Arvelous_Coders.Models.Farmer

@{
    ViewData["Title"] = "Delete Account";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="personal-account-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">DELETE ACCOUNT</h1>
        <p class="subheading">Confirm if you want to remove this farmer</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="account-container">
        <div class="account-box">
            <h3 class="form-heading">Farmer Information</h3>

            <dl class="row">
                <dt class="col-sm-3">First Name:</dt>
                <dd class="col-sm-9">@Model.FirstName</dd>

                <dt class="col-sm-3">Surname:</dt>
                <dd class="col-sm-9">@Model.LastName</dd>

                <dt class="col-sm-3">ID Number:</dt>
                <dd class="col-sm-9">@Model.Idnumber</dd>

                <dt class="col-sm-3">Phone Number:</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>

                <dt class="col-sm-3">Email Address:</dt>
                <dd class="col-sm-9">@Model.EmailAddress</dd>

                <dt class="col-sm-3">Location:</dt>
                <dd class="col-sm-9">@Model.Location</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.FarmerId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FarmerId" />
                <div class="button-row">
                    <button type="submit" class="delete-btn">DELETE ACCOUNT</button>
                    <a asp-action="Index" class="cancel-btn">CANCEL</a>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>
