@model Moo_Arvelous_Coders.Models.Farmer

@{
    ViewData["Title"] = "Edit Farmer";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">Edit Farmer</h2>
        <p>Update your personal information below.</p>

        <div class="account-box">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FarmerId" />

                <dl class="row">
                    <dt class="col-sm-4">First Name:</dt>
                    <dd class="col-sm-8"><input asp-for="FirstName" class="form-control" /></dd>

                    <dt class="col-sm-4">Surname:</dt>
                    <dd class="col-sm-8"><input asp-for="LastName" class="form-control" /></dd>

                    <dt class="col-sm-4">Email Address:</dt>
                    <dd class="col-sm-8"><input asp-for="EmailAddress" class="form-control" /></dd>

                    <dt class="col-sm-4">Phone Number:</dt>
                    <dd class="col-sm-8"><input asp-for="PhoneNumber" class="form-control" /></dd>

                    <dt class="col-sm-4">ID Number:</dt>
                    <dd class="col-sm-8"><input asp-for="Idnumber" class="form-control" /></dd>

                    <dt class="col-sm-4">Location:</dt>
                    <dd class="col-sm-8"><input asp-for="Location" class="form-control" /></dd>

                    <dt class="col-sm-4">Password:</dt>
                    <dd class="col-sm-8"><input asp-for="Password" class="form-control" /></dd>

                    <dt class="col-sm-4">Confirm Password:</dt>
                    <dd class="col-sm-8"><input asp-for="ConfirmPassword" class="form-control" /></dd>
                </dl>

                <div class="button-row">
                    <button type="submit" class="home-button">SAVE CHANGES</button>
                    <a asp-action="Details" asp-route-id="@Model.FarmerId" class="home-button btn-secondary">Cancel</a>
                </div>
            </form>
        </div>

        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
