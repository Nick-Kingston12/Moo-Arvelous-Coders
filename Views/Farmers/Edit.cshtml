@model Moo_Arvelous_Coders.Models.Farmer

@{
    ViewData["Title"] = "Edit Account";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="personal-account-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">PERSONAL ACCOUNT</h1>
        <p class="subheading">View and manage your personal account</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="account-container">
        <div class="image-container">
            <img src="~/images/farmer.png" alt="Cartoon Farmer" />
        </div>

        <div class="account-box">
            <h3 class="form-heading">Personal Information</h3>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FarmerId" />

                <label asp-for="FirstName">First Name:</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>

                <label asp-for="LastName">Surname:</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>

                <label asp-for="EmailAddress">Email Address:</label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>

                <label asp-for="PhoneNumber">Contact Number:</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                <label asp-for="Idnumber">ID Number:</label>
                <input asp-for="Idnumber" class="form-control" />
                <span asp-validation-for="Idnumber" class="text-danger"></span>

                <label>Current Password:</label>
                <input type="password" asp-for="Password" class="form-control" />

                <label>Update Password:</label>
                <input type="password" name="NewPassword" class="form-control" />

                <div class="button-row">
                    <button type="submit" class="submit-btn">SAVE</button>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
