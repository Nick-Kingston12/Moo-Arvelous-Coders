@model Moo_Arvelous_Coders.Models.Farmer

@{
    ViewData["Title"] = "Create Farmer";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="create-farmer-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">REGISTER FARMER</h1>
        <p class="subheading">Don't have an account yet? Create a farming profile.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="register-container">

        <div class="image-container">
            <img src="~/images/farmer.png" alt="Cartoon Farmer" />
        </div>

        <div class="left-box">
            <h3 class="form-heading">NOTES</h3>
            <p class="reg-words">
                Create your farmer profile by entering your personal information within the fields on the right-hand side.
                <br><br>
                All fields are required and have to be filled in.
                <br><br>
                Create a strong password using uppercase, lowercase letters, numbers, and symbols.
            </p>
        </div>

        <div class="right-form">
            <h3 class="form-heading">PERSONAL INFORMATION</h3>
            <form asp-action="Create" method="post">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @if (Model?.FarmerId != null)
                {
                    <div class="form-group">
                        <label>Farmer ID (generated):</label>
                        <input class="form-control" value="@Model.FarmerId" readonly />
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label asp-for="FirstName" class="control-label">First Name:</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>

                <label asp-for="LastName" class="control-label">Last Name:</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>

                <label asp-for="Idnumber" class="control-label">ID Number:</label>
                <input asp-for="Idnumber" class="form-control" maxlength="13" pattern="\d{13}" title="ID Number must be exactly 13 digits" />
                <span asp-validation-for="Idnumber" class="text-danger"></span>

                <label asp-for="PhoneNumber" class="control-label">Phone Number:</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                <label asp-for="EmailAddress" class="control-label">Email Address:</label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>

                <label asp-for="Location" class="control-label">Location:</label>
                <select asp-for="Location" class="form-control">
                    <option value="">-- Select Province --</option>
                    <option value="Eastern Cape">Eastern Cape</option>
                    <option value="Free State">Free State</option>
                    <option value="Gauteng">Gauteng</option>
                    <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                    <option value="Limpopo">Limpopo</option>
                    <option value="Mpumalanga">Mpumalanga</option>
                    <option value="Northern Cape">Northern Cape</option>
                    <option value="North West">North West</option>
                    <option value="Western Cape">Western Cape</option>
                </select>
                <span asp-validation-for="Location" class="text-danger"></span>


                <!-- Password field -->
                <label asp-for="Password" class="control-label">Password:</label>
                <div class="password-container">
                    <input asp-for="Password" type="password" class="form-control" id="Password" />
                    <button type="button" class="toggle-password" onclick="togglePassword('Password')">
                        👁
                    </button>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <label asp-for="ConfirmPassword" class="control-label">Confirm Password:</label>
                <div class="password-container">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword" />
                    <button type="button" class="toggle-password" onclick="togglePassword('ConfirmPassword')">
                        👁
                    </button>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Form Buttons -->
                <div class="button-row">
                    <button type="reset" class="clear-btn">CLEAR FORM</button>
                    <button type="submit" class="submit-btn">CREATE ACCOUNT</button>
                </div>
            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="text-danger" style="margin-top: 1rem;">
                    ❗ Please correct the highlighted errors before submitting the form.
                </div>
            }

        </div>

    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function togglePassword(fieldId) {
            var input = document.getElementById(fieldId);
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }
    </script>
}

