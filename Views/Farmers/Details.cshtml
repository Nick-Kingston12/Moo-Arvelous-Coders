@model Moo_Arvelous_Coders.Models.Farmer

@{
    ViewData["Title"] = "Farmer Details";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">Farmer Details</h2>
        <p>View detailed information about your farmer.</p>

        <div class="account-box">
            <h3 class="form-heading">Personal Information</h3>
            <dl class="row">
                <dt class="col-sm-4">First Name:</dt>
                <dd class="col-sm-8">@Model.FirstName</dd>

                <dt class="col-sm-4">Surname:</dt>
                <dd class="col-sm-8">@Model.LastName</dd>

                <dt class="col-sm-4">ID Number:</dt>
                <dd class="col-sm-8">@Model.Idnumber</dd>

                <dt class="col-sm-4">Phone Number:</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>

                <dt class="col-sm-4">Email Address:</dt>
                <dd class="col-sm-8">@Model.EmailAddress</dd>

                <dt class="col-sm-4">Location:</dt>
                <dd class="col-sm-8">@Model.Location</dd>
            </dl>

            <div class="button-row">
                <a asp-action="Edit" asp-route-id="@Model.FarmerId" class="home-button">Edit</a>
                <a asp-action="Index" class="home-button btn-secondary">Back to List</a>
            </div>
        </div>

        <footer class="footer-text">
            <p>Life isn't perfect, but with HerdWise your farm can be.</p>
        </footer>
    </div>
</div>
