@model IEnumerable<Moo_Arvelous_Coders.Models.Farmer>

@{
    ViewData["Title"] = "Farmers";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="page-container">
    <!-- HEADER -->
    <div class="farm-header" style="text-align: center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">FARMERS</h1>
        <p class="subtitle">Manage registered farmers. View details, or remove from the system.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <!-- CREATE BUTTON -->
    <div class="form-container" style="justify-content: center; margin-top: 1rem;">
        <a asp-action="Create" class="btn create-btn">CREATE NEW FARMER</a>
    </div>

    <!-- TABLE SECTION -->
    <div class="farm-list-box" style="margin-top: 2rem;">
        <div class="box-header">Farmers List</div>

        <table class="records-table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>ID Number</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var farmer in Model)
                {
                    <tr>
                        <td>@farmer.FirstName</td>
                        <td>@farmer.LastName</td>
                        <td>@farmer.Idnumber</td>
                        <td>@farmer.PhoneNumber</td>
                        <td>@farmer.EmailAddress</td>
                        <td>@farmer.Location</td>
                        <td>
                            <div style="display:flex; gap:8px; justify-content:center;">
                                <a asp-action="Details" asp-route-id="@farmer.FarmerId" class="btn save-btn">DETAILS</a>
                                <a asp-action="Delete" asp-route-id="@farmer.FarmerId" class="btn delete-btn">DELETE</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="footer-text">Life isn’t perfect, but with HerdWise your farm can be.</p>
</div>
