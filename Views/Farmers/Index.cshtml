@model IEnumerable<Moo_Arvelous_Coders.Models.Farmer>

@{
    ViewData["Title"] = "Farmers";
}

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2>Farmers List</h2>
        <p>Manage your farmers below:</p>

        <a asp-action="Create" class="home-button">Create New Farmer</a>

        <table class="table custom-table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>ID Number</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var farmer in Model)
                {
                    <tr>
                        <td>@farmer.FirstName</td>
                        <td>@farmer.LastName</td>
                        <td>@farmer.Idnumber</td>
                        <td>@farmer.PhoneNumber</td>
                        <td>@farmer.EmailAddress</td>
                        <td>@farmer.Location</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@farmer.FarmerId" class="home-button">Edit</a>
                            <a asp-action="Details" asp-route-id="@farmer.FarmerId" class="home-button">Details</a>
                            <a asp-action="Delete" asp-route-id="@farmer.FarmerId" class="home-button btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
