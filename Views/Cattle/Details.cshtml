@model Moo_Arvelous_Coders.Models.Cattle
@{
    ViewData["Title"] = "Cattle Details";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="page-container">
    <div class="header-section">
        <img src="~/images/Logo.png" alt="Logo" class="logo-top" />
        <h1 class="welcome-title">VIEW CATTLE INFORMATION</h1>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="main-cattle-container">
        <div class="photo-section">
            <img src="~/images/cattle-placeholder.png" alt="Cattle photo" class="photo-display" />

            <div class="photo-buttons">
                <button type="button" class="upload-btn">UPLOAD PHOTO</button>
                <button type="button" class="delete-btn">DELETE PHOTO</button>
            </div>

            <div class="photo-instructions">
                <ul>
                    <li>• JPG or PNG format</li>
                    <li>• Max file size: 5MB</li>
                    <li>• Full body photo</li>
                    <li>• Use natural lighting</li>
                    <li>• One animal per photo</li>
                </ul>
            </div>
        </div>

        <div class="cattle-form cattle-details">
            <h3 class="form-headingC">Cattle Information</h3>

            <p><strong>Cattle ID:</strong> @Model.CattleId</p>
            <p><strong>Breed:</strong> @Model.Breed</p>
            <p><strong>Gender:</strong> @Model.Gender</p>
            <p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</p>
            <p><strong>Weight:</strong> @Model.Weight kg</p>
            <p><strong>Herd ID:</strong> @Model.HerdId</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Date of Death:</strong> @Model.DateOfDeath?.ToString("yyyy-MM-dd")</p>

            <div class="button-row">
                <a asp-action="Edit" asp-route-id="@Model.CattleId" class="save-btn">EDIT + UPDATE</a>
                <a asp-action="HealthRecords" asp-route-id="@Model.CattleId" class="health-btn">HEALTH RECORDS</a>
                <a asp-action="Index" class="cancel-btn">BACK</a>
            </div>
        </div>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>
