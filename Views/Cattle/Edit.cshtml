@model Moo_Arvelous_Coders.Models.Cattle
@{
    ViewData["Title"] = "Edit Cattle";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">EDIT CATTLE</h2>
        <p>Update your cow’s details below.</p>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CattleId" />

            <!-- PHOTO -->
            <div class="photo-section">
                <img src="@(Model.CattlePhotos.FirstOrDefault()?.PhotoUrl ?? "/images/cattle-placeholder.png")"
                     alt="Cattle Photo"
                     id="photoPreview"
                     class="photo-display" />

                <label>Change Photo:</label>
                <input type="file" name="photo" id="photoInput" class="form-control" accept=".jpg,.png" />
            </div>

            <!-- CATTLE INFO -->
            <label>Gender:</label>
            <div class="options">
                <input type="radio" asp-for="Gender" value="Male" /> Male
                <input type="radio" asp-for="Gender" value="Female" /> Female
            </div>

            <label>Breed:</label>
            <select asp-for="Breed" class="form-control">
                <option value="">-- Select Breed --</option>
                <option>Afrikaner</option>
                <option>Beefmaster</option>
                <option>Bonsmara</option>
                <option>Brahman</option>
                <option>Hereford</option>
                <option>Nguni</option>
                <option>Simmentaler</option>
            </select>

            <label>Date of Birth:</label>
            <input type="date" asp-for="DateOfBirth" class="form-control" value="@Model.DateOfBirth.ToDateTime(TimeOnly.MinValue).ToString("yyyy-MM-dd")" />


            <label>Weight (kg):</label>
            <input asp-for="Weight" class="form-control" />

            <label>Status:</label>
            <div class="options">
                <input type="radio" asp-for="Status" value="Normal" /> Normal
                <input type="radio" asp-for="Status" value="Prepping for sale" /> Prepping for sale
                <input type="radio" asp-for="Status" value="Sell" /> Sell
                <input type="radio" asp-for="Status" value="Sold" /> Sold
            </div>

            <label>Date of Death:</label>
            <input type="date" asp-for="DateOfDeath" class="form-control"
                   value="@(Model.DateOfDeath.HasValue? Model.DateOfDeath.Value.ToDateTime(TimeOnly.MinValue).ToString("yyyy-MM-dd") : string.Empty)" />


            <div class="button-row">
                <button type="submit" class="home-button">SAVE CHANGES</button>
                <a asp-action="Index" class="home-button btn-secondary">CANCEL</a>
            </div>
        </form>
    </div>
</div>

<script>
    // Live preview when changing photo
    const photoInput = document.getElementById("photoInput");
    const photoPreview = document.getElementById("photoPreview");

    photoInput.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                photoPreview.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
</script>
