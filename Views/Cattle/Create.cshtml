@model Moo_Arvelous_Coders.Models.CattleCreateViewModel

@{
    ViewData["Title"] = "Create Cattle";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="create-farmer-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">CREATE COW PROFILE</h1>
        <p class="subheading">CREATE AND MANAGE YOUR INDIVIDUAL COW INFORMATION BELOW.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>
</div>

<div class="cattle-container">

    <div class="photo-section">
        <div class="photo-box">
            <i class="upload-icon">☁️</i>
        </div>
        <form asp-action="Create" asp-controller="Cattle" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="photo">UPLOAD PHOTO</label>
                <input type="file" name="PhotoFile" id="photo" class="form-control" accept="image/*" />
            </div>
            <button type="submit" class="upload-btn">UPLOAD PHOTO</button>
        </form>
        <form method="post" asp-page-handler="DeletePhoto">
            <button type="submit" class="delete-btn">DELETE PHOTO</button>
        </form>
        <div class="left-cattle">
            <h3 class="form-heading">INSTRUCTIONS</h3>
            <p class ="reg-words">
                JPG or PNG format.<br />
                Max file size: 5MB.<br />
                Full body photo.<br />
                Use natural lighting.<br />
                One animal per photo<br />
            </p>
        </div>
    </div>

    <div class="cattle-info">
        <h3 class="form-heading">CATTLE INFORMATION</h3>
        <form method="post" asp-page-handler="SaveCattle" asp-controller="Cattle" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken() 
            <label class="reg-words">Cattle ID:</label>
            <input asp-for="Cattle.CattleId" placeholder="Enter unique cattle ID number" />

            <label class="reg-words">Gender:</label>
            <input type="radio" asp-for="Cattle.Gender" value="Male" /> Male
            <input type="radio" asp-for="Cattle.Gender" value="Female" /> Female

            <label class="reg-words">Breed:</label>
            <select asp-for="Cattle.Breed" class="form-control">
                <option>- Select the correct breed option --</option>
                <option>Afrikaner</option>
                <option>Beefmaster</option>
                <option>Bonsmara</option>
                <option>Brahman</option>
                <option>Charolais</option>
                <option>Hereford</option>
                <option>Limousin</option>
                <option>Nguni</option>
                <option>Santa Gertrudis</option>
                <option>Simmentaler</option>
            </select>

            <label class="reg-words">Date of Birth:</label>
            <input type="date" asp-for="Cattle.DateOfBirth" />

            <label class="reg-words">Herd ID:</label>
            <input asp-for="Cattle.HerdId" placeholder="Confirm Herd ID number" />

            <label class="reg-words">Status:</label>
            <input type="radio" asp-for="Cattle.Status" value="Normal" /> Normal
            <input type="radio" asp-for="Cattle.Status" value="Prepping for sale" /> Prepping for sale
            <input type="radio" asp-for="Cattle.Status" value="Sell" /> Sell
            <input type="radio" asp-for="Cattle.Status" value="Sold" /> Sold

            <button type="reset" class="clear-btn">CLEAR FORM</button>
            <button type="submit" class="save-btn">SAVE</button>
        </form>
    </div>

    <div class="health-section">
        <h3 class="form-heading">HEALTH RECORDS</h3>
        <form method="post" asp-page-handler="SaveHealthRecord">
            <label>Health Record ID:</label>
            <input asp-for="HealthRecord.RecordId" placeholder="Enter unique record ID number" />

            <label>Cattle ID:</label>
            <input asp-for="HealthRecord.CattleId" placeholder="Confirm ID" />

            <label>Date of Entry:</label>
            <input type="date" asp-for="HealthRecord.RecordDate" />

            <label>Treatment Type:</label>
            <select asp-for="HealthRecord.TreatmentType" class="form-control">
                <option value="">-- Select a treatment --</option>
                <option>Flu Vaccination</option>
                <option>Worm Medicine / Deworming</option>
                <option>Lice & Tick Dip / Flea Dip</option>
                <option>Vitamin Injection</option>
                <option>Antibiotic Treatment</option>
                <option>Foot Rot Treatment</option>
                <option>Mastitis Treatment</option>
                <option>Rabies Vaccination</option>
                <option>Brucellosis Vaccine</option>
                <option>Pinkeye Treatment</option>
                <option>Injury Treatment (Wound Care)</option>
                <option>Reproductive Health Treatment</option>
                <option>Hoof Trimming</option>
                <option>Pregnancy Diagnosis (Vet Check)</option>
                <option>General Health Check / Annual Vet Visit</option>
            </select>

            <label>Details:</label>
            <textarea asp-for="HealthRecord.Details" placeholder="Add extra health notes..."></textarea>


            <button type="submit" class="record-btn">RECORD HEALTH ENTRY</button>
        </form>
        <form method="post" asp-page-handler="UpdateHealthRecord">
            <button type="submit" class="update-btn">EDIT + UPDATE</button>
        </form>
    </div>
</div>