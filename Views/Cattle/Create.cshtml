@model Moo_Arvelous_Coders.Models.Cattle
@{
    ViewData["Title"] = "Create Cattle";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="page-container">
    <div class="farm-header" style="text-align: center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">CREATE COW PROFILE</h1>
        <p class="subtitle">Add a new cow to your herd records.</p>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="main-cattle-container">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="cattle-form">
            @Html.AntiForgeryToken()

            <!-- PHOTO UPLOAD -->
            
            <div class="photo-section" style="display: flex; align-items: flex-start; gap: 20px;">
                <div class="photo-instructions" style="margin-top: 10px;">
                    <ul style="list-style: disc; padding-left: 20px; margin: 0;">
                        <li>JPG or PNG format</li>
                        <li>Max file size: 5MB</li>
                        <li>Full body photo</li>
                        <li>One animal per photo</li>
                    </ul>
                </div>
                <div class="photo-preview-container">
                    <img src="~/images/cattle-placeholder.png" alt="Photo Preview" class="photo-display" id="photoPreview" />
                    <label class="upload-label">Upload Photo</label>
                    <input type="file" name="photo" id="photoInput" class="form-control" accept=".jpg,.png" />
                </div>

                
            </div>


            <!-- CATTLE INFO -->
            <h3 class="form-headingC">Cattle Information</h3>

            <label>Gender:</label>
            <div class="gender-options">
                <label><input type="radio" asp-for="Gender" value="Male" /> Male</label>
                <label><input type="radio" asp-for="Gender" value="Female" /> Female</label>
            </div>


            <label>Breed:</label>
            <select asp-for="Breed" class="form-control">
                <option value="">-- Select Breed --</option>
                <option>Afrikaner</option>
                <option>Beefmaster</option>
                <option>Bonsmara</option>
                <option>Brahman</option>
                <option>Hereford</option>
                <option>Nguni</option>
                <option>Simmentaler</option>
            </select>

            <label>Date of Birth:</label>
            <input asp-for="DateOfBirth" type="date" class="form-control"
                   value="@(Model.DateOfBirth == default ? DateTime.Today.ToString("yyyy-MM-dd") : Model.DateOfBirth.ToDateTime(TimeOnly.MinValue).ToString("yyyy-MM-dd"))" />

            <label>Weight (kg):</label>
            <input asp-for="Weight" class="form-control" />

            <label>Select Herd:</label>
            <select asp-for="HerdId" class="form-control">
                <option value="">-- Select a Herd --</option>
                @foreach (var herd in ViewBag.Herds)
                {
                    <option value="@herd.HerdId">@herd.HerdName</option>
                }
            </select>

            <label>Status:</label>
            <div class="options" style="display: flex; gap: 15px; align-items: center;">
                <label><input type="radio" asp-for="Status" value="Normal" /> Normal</label>
                <label><input type="radio" asp-for="Status" value="Prepping for sale" /> Prepping for sale</label>
                <label><input type="radio" asp-for="Status" value="Sell" /> Sell</label>
                <label><input type="radio" asp-for="Status" value="Sold" /> Sold</label>
            </div>


            <label>Date of Death:</label>
            <input asp-for="DateOfDeath" type="date" class="form-control"
                   value="@(Model.DateOfDeath.HasValue? Model.DateOfDeath.Value.ToDateTime(TimeOnly.MinValue).ToString("yyyy-MM-dd") : "")" />

            <div class="button-row">
                <button type="submit" class="save-btn">SAVE</button>
                <a asp-action="Index" class="btn cancel-btn">CANCEL</a>
            </div>
        </form>

    </div>
</div>

<script>
    // Show image preview
    const photoInput = document.getElementById("photoInput");
    const photoPreview = document.getElementById("photoPreview");

    photoInput.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                photoPreview.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
</script>
