@model Moo_Arvelous_Coders.Models.Cattle
@{
    ViewData["Title"] = "Create Cattle";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="page-container">
    <div class="header-section">
        <img src="~/images/Logo.png" alt="Logo" class="logo-top" />
        <h1 class="welcome-title">CREATE COW PROFILE</h1>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <div class="main-cattle-container">
        <div class="photo-section">
            <div class="photo-placeholder">
                <i class="fa fa-cloud-upload upload-icon"></i>
            </div>

            <div class="photo-buttons">
                <button type="button" class="upload-btn">UPLOAD PHOTO</button>
                <button type="button" class="delete-btn">DELETE PHOTO</button>
            </div>

            <div class="photo-instructions">
                <ul>
                    <li>• JPG or PNG format</li>
                    <li>• Max file size: 5MB</li>
                    <li>• Full body photo</li>
                    <li>• Use natural lighting</li>
                    <li>• One animal per photo</li>
                </ul>
            </div>
        </div>

        <form asp-action="Create" method="post" class="cattle-form">
            <h3 class="form-headingC">Cattle Information</h3>

            <label>Gender:</label>
            <div class="options">
                <input type="radio" asp-for="Gender" value="Male" /> Male
                <input type="radio" asp-for="Gender" value="Female" /> Female
            </div>

            <label>Breed:</label>
            <select asp-for="Breed">
                <option value="">-- Select Breed --</option>
                <option>Afrikaner</option>
                <option>Beefmaster</option>
                <option>Bonsmara</option>
                <option>Brahman</option>
                <option>Hereford</option>
                <option>Nguni</option>
                <option>Simmentaler</option>
            </select>

            <label>Date of Birth:</label>
            <input type="date" asp-for="DateOfBirth" />

            <label>Weight (kg):</label>
            <input asp-for="Weight" />

            <label>Select Herd:</label>
            <select asp-for="HerdId" class="form-control">
                <option value="">-- Select a Herd --</option>
                @foreach (var herd in ViewBag.Herds)
                {
                    <option value="@herd.HerdId">@herd.HerdName</option>
                }
            </select>

            <label>Status:</label>
            <div class="options">
                <input type="radio" asp-for="Status" value="Normal" /> Normal
                <input type="radio" asp-for="Status" value="Prepping for sale" /> Prepping for sale
                <input type="radio" asp-for="Status" value="Sell" /> Sell
                <input type="radio" asp-for="Status" value="Sold" /> Sold
            </div>

            <label>Date of Death:</label>
            <input type="date" asp-for="DateOfDeath" />

            <div class="button-row">
                <button type="submit" class="save-btn">SAVE</button>
                <a asp-action="Index" class="cancel-btn">CANCEL</a>
            </div>
        </form>
    </div>

    <footer class="footer-text">
        <p>Life isn't perfect, but with HerdWise your farm can be.</p>
    </footer>
</div>
