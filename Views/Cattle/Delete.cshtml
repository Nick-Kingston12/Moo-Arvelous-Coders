@model Moo_Arvelous_Coders.Models.Cattle

@{
    ViewData["Title"] = "Delete Cattle";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="herd-create-container">
    <!-- HEADER -->
    <div class="herd-header">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="welcome-title">DELETE CATTLE</h1>
        <p class="subheading">Are you sure you want to remove this cattle record?</p>
    </div>

    <!-- CONTENT -->
    <div class="form-herd-container">
        

        <div class="herd-content">
            <form asp-action="Delete" method="post" class="herd-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CattleId" />

                <div class="form-box">
                    <p><strong>Breed:</strong> @Model.Breed</p>
                    <p><strong>Gender:</strong> @Model.Gender</p>
                    <p><strong>Weight:</strong> @Model.Weight kg</p>
                    <p><strong>Status:</strong> @Model.Status</p>
                </div>

                <div class="herd-form-actions">
                    <button type="submit" class="delete-btn">YES, DELETE</button>
                    <a asp-action="Index" class="home-button btn-secondary">NO, GO BACK</a>
                </div>
            </form>
        </div>
    </div>

    <!-- FOOTER -->
    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>
