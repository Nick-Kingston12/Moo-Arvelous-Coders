@model Moo_Arvelous_Coders.Models.Cattle
@{
    ViewData["Title"] = "Delete Cattle";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="landing-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">DELETE CATTLE</h2>
        <p>Confirm if you want to remove this cattle record.</p>

        <div class="account-box">
            <h3 class="form-headingC">CATTLE INFORMATION</h3>
            <p><strong>Breed:</strong> @Model.Breed</p>
            <p><strong>Gender:</strong> @Model.Gender</p>
            <p><strong>Weight:</strong> @Model.Weight kg</p>
            <p><strong>Status:</strong> @Model.Status</p>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CattleId" />
                <div class="button-row">
                    <button type="submit" class="delete-btn">CONFIRM DELETE</button>
                    <a asp-action="Index" class="home-button btn-secondary">CANCEL</a>
                </div>
            </form>
        </div>

        <footer class="footer-text">
            <p>Careful decisions keep your herd thriving.</p>
        </footer>
    </div>
</div>
