@model IEnumerable<Moo_Arvelous_Coders.Models.Cattle>
@{
    ViewData["Title"] = "Cattle List";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="list-container">
    <div class="herd-header">
        <img src="~/images/Logo.png" class="logo-top" alt="Logo" />
        <h1 class="welcome-title">CATTLE LIST</h1>
        <a class="menu-button" href="/">MENU</a>
    </div>

    <a asp-action="Create" class="btn create-btn">+ ADD NEW CATTLE</a>

    <table class="records-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Breed</th>
                <th>Gender</th>
                <th>Weight</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cattle in Model)
            {
                <tr>
                    <td>@cattle.CattleId</td>
                    <td>@cattle.Breed</td>
                    <td>@cattle.Gender</td>
                    <td>@cattle.Weight kg</td>
                    <td>@cattle.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@cattle.CattleId" class="btn details-btn">View</a>
                        <a asp-action="Edit" asp-route-id="@cattle.CattleId" class="btn edit-btn">Edit</a>
                        <a asp-action="Delete" asp-route-id="@cattle.CattleId" class="btn delete-btn">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<footer class="footer-text">
    <p>Life isn't perfect, but with HerdWise your farm can be.</p>
</footer>
