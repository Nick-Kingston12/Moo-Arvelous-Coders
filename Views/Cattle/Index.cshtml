@model IEnumerable<Moo_Arvelous_Coders.Models.Cattle>

@{
    ViewData["Title"] = "Cattle";
}

<link rel="stylesheet" href="~/css/site.css" />
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<div class="farm-list-container">
    <!-- HEADER -->
    <div class="farm-header" style="text-align: center;">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-top" />
        <h1 class="form-title">CATTLE</h1>
        <p class="subtitle">Manage your herd's cattle — view, add, or delete cattle below.</p>
    </div>

    <!-- CREATE NEW CATTLE BUTTON -->
    <div class="form-container" style="justify-content: center; margin-top: 1rem;">
        <a class="btn create-btn" asp-action="Create">ADD NEW CATTLE</a>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message" style="text-align:center; margin-top:10px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- CATTLE TABLE -->
    <div class="farmers-table-container">
        <h3>Your Cattle</h3>
        <p class="instruction">Browse and manage cattle details below.</p>

        <table class="farmers-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Breed</th>
                    <th>Gender</th>
                    <th>Weight (kg)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="cattleList">
                @if (Model != null && Model.Any())
                {
                    foreach (var cattle in Model)
                    {
                        <tr class="cattle-item">
                            <td>@cattle.CattleId</td>
                            <td>@cattle.Breed</td>
                            <td>@cattle.Gender</td>
                            <td>@cattle.Weight</td>
                            <td>@cattle.Status</td>
                            <td>
                                <div class="button-group">
                                    <a asp-action="Details" asp-route-id="@cattle.CattleId" class="btn details-btn">VIEW</a>
                                    <a asp-action="Delete" asp-route-id="@cattle.CattleId" class="btn delete-btn">DELETE</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center;">No cattle found.</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Arrows -->
        <div class="arrow-nav">
            <span class="arrow left-arrow" id="cattlePrevArrow">←</span>
            <span class="arrow right-arrow" id="cattleNextArrow">→</span>
        </div>
    </div>

    <!-- FOOTER -->
    <p class="footer-text">Life isn’t perfect, but with HerdWise your herd can be.</p>
</div>

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        setupPagination("#cattleList tr", "#cattlePrevArrow", "#cattleNextArrow", 5);
    </script>
}
