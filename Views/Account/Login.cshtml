@model Moo_Arvelous_Coders.Models.LoginViewModel


@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
}

<div class="account-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">LOGIN</h2>
        <p>Access your farm and herd profile</p>

        <form method="post" asp-controller="Account" asp-action="Login" class="account-box">
            <label asp-for="EmailAddress">Email Address</label>
            <input asp-for="EmailAddress" placeholder="Enter your email address" class="form-control" />
            <span asp-validation-for="EmailAddress" class="text-danger"></span>

            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" placeholder="Enter your password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <button type="submit" class="home-button">LOGIN 🔒</button>

            <span asp-validation-summary="All" class="text-danger"></span>
        </form>

        <p class="footer-text">Life isn't perfect, but with HerdWise your farm can be.</p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}


       

