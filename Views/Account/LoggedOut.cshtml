@{
    ViewData["Title"] = "Logout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
}

<div class="account-wrapper">
    <div class="left-color-block">
        <img src="~/images/Logo.png" alt="HerdWise Logo" class="logo-image" />
    </div>

    <div class="right-content">
        <h2 class="welcome-title">LOGOUT</h2>
        <p>Leave your farm and herd profile</p>

        <div class="account-box" style="text-align: center;">
            <p>😊 Ready to logout and hit the hay?</p>
            <p>Your data is safely stored and your herd is in good hands.</p>

            <form method="get" asp-controller="Home" asp-action="Index1">
                <button type="submit" class="home-button">LOGOUT 🔒</button>
            </form>

            <p style="margin-top: 20px;">Thank you for using HerdWise.<br />Looking forward to your next visit Farmer!</p>
        </div>

        <p class="footer-text">Life isn't perfect, but with HerdWise your farm can be.</p>
    </div>
</div>
